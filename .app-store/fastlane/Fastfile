default_platform(:ios)

platform :ios do
  desc "Upload the approved PressBench App Store screenshots without submitting"
  lane :upload_pressbench_screenshots do
    deliver(
      api_key_path: ENV.fetch("PB_ASC_KEY_JSON"),
      app_identifier: "com.goodusestudios.pressbench",
      platform: "ios",
      app_version: "1.0",
      screenshots_path: ENV.fetch("PB_SCREENSHOT_DIR"),
      skip_binary_upload: true,
      skip_metadata: true,
      skip_app_version_update: true,
      overwrite_screenshots: true,
      run_precheck_before_submit: false,
      submit_for_review: false,
      force: true
    )
  end
end
